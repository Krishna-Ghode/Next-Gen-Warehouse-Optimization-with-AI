# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example
#
# Copy this file to .env and fill in real values before starting the server.
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed.
# This file (.env.example) contains only safe placeholders — commit it freely.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────

# Port the Express server listens on.
PORT=5000

# ── JWT (local HS256 tokens) ──────────────────────────────────────────────────
#
# Used to sign and verify local JWTs issued by POST /api/auth/login.
# Must be a cryptographically random string of at least 64 bytes (128 hex chars).
#
# Generate a new secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# SECURITY RULES:
#   - Never use a short, guessable, or human-readable value here.
#   - Never share or commit the real value.
#   - Rotate this secret if it is ever exposed; all existing local JWTs will
#     be immediately invalidated and users will need to log in again.
JWT_SECRET=replace_with_128_hex_char_random_secret

# Lifetime of local JWTs (e.g. 24h, 7d, 1h). Keep short-lived.
JWT_EXPIRES_IN=24h

# ── Supabase ─────────────────────────────────────────────────────────────────
#
# JWKS endpoint used by middleware/auth.js to verify Supabase RS256 tokens.
# Pattern: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Find your project ref in: Supabase Dashboard → Project Settings → General.
SUPABASE_JWKS_URI=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
#
# Required only for the AI chat feature (POST /api/chat).
# If not set, the chat endpoint falls back to rule-based responses automatically.
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-openai-api-key-here

# ── Python runtime (optional) ────────────────────────────────────────────────
#
# Path to the Python executable used to run ML scripts.
# Only needed if the system default 'python' does not resolve correctly
# (e.g. on Windows with a conda/venv environment).
# Leave unset to use the system default.
# Example (Windows conda): PYTHON_PATH=C:\Users\you\miniconda3\envs\myenv\python.exe
# PYTHON_PATH=python
