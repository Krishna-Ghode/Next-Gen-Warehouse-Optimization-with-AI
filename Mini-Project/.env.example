# ─────────────────────────────────────────────────────────────────────────────
# Mini-Project/.env.example
#
# Copy this file to .env and fill in your real values before running the app.
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed.
# This file (.env.example) contains only safe placeholders — commit it freely.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Maps JavaScript API ───────────────────────────────────────────────
#
# Used by AdminTracking.jsx (Company Dashboard map) and AgentDashboard.jsx.
# Vite exposes variables prefixed with VITE_ to browser code at build time.
#
# Required Google Cloud APIs to enable for this key:
#   • Maps JavaScript API  — renders map tiles
#   • Directions API       — route polylines in Agent Dashboard
#
# Get / create a key at:
#   https://console.cloud.google.com/apis/credentials
#
# For local development, remove HTTP referrer restrictions on the key,
# or add http://localhost:5173/* as an allowed referrer.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
